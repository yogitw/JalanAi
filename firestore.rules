rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidRoadInspection(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.estateId == 'kebun_sei_rokan' &&
             data.inspectorName is string && data.inspectorName.size() <= 60 &&
             data.roadName is string && data.roadName.size() >= 2 && data.roadName.size() <= 120 &&
             data.segmentLocation is string && data.segmentLocation.size() <= 120 &&
             data.regionName is string && data.regionName.size() <= 100 &&
             data.trafficIntensity in ['RENDAH', 'SEDANG', 'TINGGI'] &&
             data.videoSourceLabel is string && data.videoSourceLabel.size() >= 1 && data.videoSourceLabel.size() <= 120 &&
             data.framesAnalyzed is int && data.framesAnalyzed >= 1 && data.framesAnalyzed <= 12 &&
             data.roadSummary is string && data.roadSummary.size() >= 1 && data.roadSummary.size() <= 1000 &&
             data.pciScore is int && data.pciScore >= 0 && data.pciScore <= 100 &&
             (data.iriEstimate is int || data.iriEstimate is float) && data.iriEstimate >= 0 && data.iriEstimate <= 25 &&
             data.conditionCategory in ['BAIK', 'SEDANG', 'RUSAK_RINGAN', 'RUSAK_BERAT'] &&
             data.optimalMaintenanceMonth is string && data.optimalMaintenanceMonth.size() >= 3 && data.optimalMaintenanceMonth.size() <= 40 &&
             data.urgencyWindow is string && data.urgencyWindow.size() >= 2 && data.urgencyWindow.size() <= 60 &&
             data.preventiveMethod is string && data.preventiveMethod.size() >= 2 && data.preventiveMethod.size() <= 200 &&
             data.maintenanceRationale is string && data.maintenanceRationale.size() >= 2 && data.maintenanceRationale.size() <= 1000 &&
             data.rainfallSummary is string && data.rainfallSummary.size() <= 600 &&
             data.rainfallSourceNote is string && data.rainfallSourceNote.size() <= 300 &&
             data.costSavingsPercent is int && data.costSavingsPercent >= 0 && data.costSavingsPercent <= 100 &&
             data.maintenanceStatus in ['TERJADWAL', 'PROSES', 'SELESAI'] &&
             data.maintenanceNotes is string && data.maintenanceNotes.size() <= 300 &&
             data.damages is list && data.damages.size() <= 10 &&
             (data.damages.size() == 0 || data.damages[0] is map) &&
             data.forecast is list && data.forecast.size() <= 13 &&
             (data.forecast.size() == 0 || data.forecast[0] is map) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // Shared Kebun Sei Rokan inspections collection: all authenticated APK users
    // querying estateId == 'kebun_sei_rokan' can view incoming reports and update
    // maintenance schedule progress, while deletion stays restricted to the creator.
    match /inspections/{inspectionId} {
      allow get: if isSignedIn() &&
                    isValidId(inspectionId) &&
                    existing().estateId == 'kebun_sei_rokan';

      allow list: if isSignedIn() &&
                     existing().estateId == 'kebun_sei_rokan';

      allow create: if isSignedIn() &&
                       isValidId(inspectionId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll([
                         'userId', 'estateId', 'inspectorName',
                         'roadName', 'segmentLocation', 'regionName', 'trafficIntensity',
                         'videoSourceLabel', 'framesAnalyzed', 'roadSummary', 'pciScore',
                         'iriEstimate', 'conditionCategory', 'optimalMaintenanceMonth',
                         'urgencyWindow', 'preventiveMethod', 'maintenanceRationale',
                         'rainfallSummary', 'rainfallSourceNote',
                         'costSavingsPercent', 'maintenanceStatus', 'maintenanceNotes',
                         'damages', 'forecast', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'estateId', 'inspectorName',
                         'roadName', 'segmentLocation', 'regionName', 'trafficIntensity',
                         'videoSourceLabel', 'framesAnalyzed', 'roadSummary', 'pciScore',
                         'iriEstimate', 'conditionCategory', 'optimalMaintenanceMonth',
                         'urgencyWindow', 'preventiveMethod', 'maintenanceRationale',
                         'rainfallSummary', 'rainfallSourceNote',
                         'costSavingsPercent', 'maintenanceStatus', 'maintenanceNotes',
                         'damages', 'forecast', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidRoadInspection(incoming());

      allow update: if isSignedIn() &&
                       isValidId(inspectionId) &&
                       existing().estateId == 'kebun_sei_rokan' &&
                       isValidRoadInspection(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().estateId == existing().estateId &&
                       incoming().inspectorName == existing().inspectorName &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'maintenanceStatus', 'optimalMaintenanceMonth', 'maintenanceNotes', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() &&
                       isValidId(inspectionId) &&
                       existing().userId == request.auth.uid;
    }
  }
}
